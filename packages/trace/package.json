{
  "name": "@mocon/trace",
  "version": "0.1.0",
  "description": "Makes a code-mode MCP server's executions visible in OpenTelemetry. Depends on the OpenTelemetry API only.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.3.0 <2"
  }
}
