{
  "name": "mocon",
  "version": "0.1.0",
  "description": "OpenTelemetry for code-mode MCP servers.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.3.0 <2",
    "@opentelemetry/api-logs": ">=0.50.0 <1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api-logs": {
      "optional": true
    }
  },
  "author": "tanvincible",
  "homepage": "https://tanvincible.github.io/mocon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanvincible/mocon.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/tanvincible/mocon/issues"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "mcp",
    "model-context-protocol",
    "code-mode",
    "observability",
    "tracing",
    "provenance"
  ]
}
