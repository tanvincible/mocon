{
  "name": "@mocon/adapter-mastra",
  "version": "0.1.0",
  "description": "Sink that writes mocon records into Mastra's span tree, so every exporter already wired into the framework sees them. No runtime dependencies.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@mocon/core": "^0.1.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0-0 <2.0.0-0"
  }
}
