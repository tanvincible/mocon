{
  "name": "@mocon/sink-log",
  "version": "0.1.0",
  "description": "A mocon record as a flat log line, so a log backend's panels can facet it. Depends only on @mocon/core.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@mocon/core": "^0.1.0"
  }
}
